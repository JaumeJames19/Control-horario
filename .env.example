# Copia este fichero a .env y rellena los valores de tu proyecto de Supabase.
# NUNCA subas el .env real al repositorio.

# --- Cliente (navegador). La clave publicable está pensada para ser pública. ---
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# --- Servidor (funciones de servidor / Cloudflare Worker) ---
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-publishable-key"
SUPABASE_PROJECT_ID="your-project-ref"
# Clave de servicio: SOLO en el servidor, nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Pepper para derivar la contraseña real a partir del PIN (genéralo con: node scripts/vapid.mjs)
PIN_PEPPER="your-random-pin-pepper"
# Valor anterior del pepper, solo durante una rotación (opcional)
PIN_PEPPER_PREVIOUS=""

# Avisos push (Web Push / VAPID). Genera el par con: node scripts/vapid.mjs
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_CONTACT="mailto:admin@example.com"

# Secreto con el que el programador de tareas llama a /api/avisos (opcional en local)
LOVABLE_CRON_SECRET="your-cron-secret"
LOVABLE_CRON_SECRET_PREVIOUS=""
